<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Acme.SharedKernel</AssemblyName>
    <PackageId>Acme.SharedKernel</PackageId>
    <Title>Acme.SharedKernel</Title>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Rob Martin(@ozbob)</Authors>
    <Company>ozbob.dev</Company>
    <Description>An example shared kernel project/package for use with Ardalis.CleanArchitecture template.</Description>
    <Summary>An example shared kernel project/package for use with Ardalis.CleanArchitecture template</Summary>
    <PackageProjectUrl>https://github.com/OzBob/Acme.SharedKernel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/OzBob/Acme.SharedKernel</RepositoryUrl>
    <PackageTags>DDD;Shared Kernel;SharedKernel;Domain-Driven Design;Repository;Specification;ValueObject;Value Object;Ardalis;Clean;Clean Architecture;Clean Architecture Template</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <Version>5.0.0</Version>
    <PackageReleaseNotes>
      * Updated to net10
      * Updated dependencies
      * Update to Support IAuditableEntity and ISoftDelete interfaces, and to create a Sequential Guid7 Generator.
    </PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <DocumentationFile>bin\$(Configuration)\RM.SharedKernel.xml</DocumentationFile>    
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.GuardClauses" />
    <PackageReference Include="Ardalis.Specification" />
    <PackageReference Include="Finbuckle.MultiTenant" />
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="icon.png" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>

  <PropertyGroup>
    <NoWarn>1701;1702;1591;1573;1712;NU1507</NoWarn>
  </PropertyGroup>


</Project>
